# Benchmark settings. Read by docker compose (--env-file) and passed to the loadgen container.

# Data set
FILTER_SIZE=100000
QUERY_COUNT=100000
BLOCK_RATIO=50

# Closed-loop matrix: dnsperf keeps OUTSTANDING queries in flight
SCENARIOS=baseline pass block mixed
OUTSTANDING=1 8 32 128
REPEATS=3
DURATION=10
WARMUP=2
CLIENTS=4
TIMEOUT=1

# Open-loop ramp: resperf raises the send rate from 0 to RAMP_MAX_QPS
RAMP_SCENARIOS=pass block
RAMP_MAX_QPS=600000
RAMP_TIME=30

# Ports on 127.0.0.1, the upstream port must match `listen` in knot.conf
UPSTREAM_PORT=15353
FILTER_PORT=15354

# CPU pinning (cpuset lists), keep the three sets on different physical cores
FILTER_CPUS=2
UPSTREAM_CPUS=4-7
LOADGEN_CPUS=8-11
